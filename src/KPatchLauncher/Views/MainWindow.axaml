<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KPatchLauncher.ViewModels"
        xmlns:controls="using:KPatchLauncher.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
        x:Class="KPatchLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="KotOR Patch Manager"
        Width="1100" Height="740"
        MinWidth="720" MinHeight="540"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="42"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid>
        <!-- Softened grid + scanline overlays -->
        <Border IsHitTestVisible="False" Opacity="0.10">
            <Border.Background>
                <VisualBrush TileMode="Tile"
                             SourceRect="0,0,28,28"
                             DestinationRect="0,0,28,28">
                    <VisualBrush.Visual>
                        <Canvas Width="28" Height="28">
                            <Line StartPoint="0,28" EndPoint="28,28" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1"/>
                            <Line StartPoint="28,0" EndPoint="28,28" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1"/>
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False" Opacity="0.04">
            <Border.Background>
                <VisualBrush TileMode="Tile"
                             SourceRect="0,0,4,4"
                             DestinationRect="0,0,4,4">
                    <VisualBrush.Visual>
                        <Canvas Width="4" Height="4">
                            <Rectangle Width="4" Height="1" Fill="{DynamicResource PrimaryBrush}"/>
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="42,Auto,*,Auto" Margin="0">

            <!-- 1. Title bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  PointerPressed="OnTitleBarPointerPressed"
                  DoubleTapped="OnTitleBarDoubleTapped"
                  Background="Transparent">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="KOTOR PATCH MANAGER"
                               Classes="display"
                               FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="6"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Content="K1"
                            Classes="icon"
                            Width="36"
                            Command="{Binding SelectKotor1Command}"
                            Classes.pending="{Binding IsKotor1Target}"
                            IsVisible="{Binding HasKotor1Memory}"
                            ToolTip.Tip="Switch to remembered KotOR 1"/>
                    <Button Content="K2"
                            Classes="icon"
                            Width="36"
                            Command="{Binding SelectKotor2Command}"
                            Classes.pending="{Binding IsKotor2Target}"
                            IsVisible="{Binding HasKotor2Memory}"
                            ToolTip.Tip="Switch to remembered KotOR 2"/>
                    <Button Classes="icon"
                        Width="36"
                        Margin="14,0,0,0"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh patches and status">

                    <Path Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="M17.65,6.35
                                C16.2,4.9 14.21,4 12,4
                                C7.58,4 4,7.58 4,12
                                C4,16.42 7.58,20 12,20
                                C15.73,20 18.84,17.45 19.73,14
                                L17.65,14
                                C16.83,16.33 14.61,18 12,18
                                C8.69,18 6,15.31 6,12
                                C6,8.69 8.69,6 12,6
                                C13.66,6 15.14,6.69 16.22,7.78
                                L13,11
                                L20,11
                                L20,4
                                Z" />
                </Button>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Classes="chrome"
                            Content="ABOUT"
                            Width="56"
                            Command="{Binding OpenAboutCommand}"
                            ToolTip.Tip="About (F1)"/>
                    <Button Classes="chrome"
                            Content="—"
                            Click="OnMinimize"
                            ToolTip.Tip="Minimize"/>
                    <Button Classes="chrome"
                            Content="[]"
                            Click="OnMaximize"
                            ToolTip.Tip="Maximize"/>
                    <Button Classes="chrome close"
                            Content="X"
                            Click="OnClose"
                            ToolTip.Tip="Close"/>
                </StackPanel>
            </Grid>

            <!-- 2. TARGET -->
            <controls:HudPanel Grid.Row="1"
                               Header="TARGET"
                               Subtitle="{Binding KotorVersion, StringFormat=Detected: {0}}"
                               Margin="16,8,16,0">
                <controls:HudPanel.HeaderContent>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding !IsFirstRun}">
                        <Button Content="SETTINGS"
                                Command="{Binding OpenSettingsCommand}"
                                MinWidth="88"
                                MinHeight="28"
                                Padding="8,4"
                                ToolTip.Tip="Edit game and patches paths"/>
                        <ComboBox ItemsSource="{Binding LoadoutPickerItems}"
                                  SelectedItem="{Binding SelectedLoadoutPickerItem, Mode=TwoWay}"
                                  MinHeight="28"
                                  MinWidth="120"
                                  MaxWidth="180"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding SelectedLoadoutPickerTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LoadoutPickerItem">
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="{Binding LoadoutManagerButtonLabel}"
                                Command="{Binding OpenLoadoutManagerCommand}"
                                MinWidth="96"
                                MinHeight="28"
                                Padding="8,4"
                                ToolTip.Tip="Manage loadouts (save, delete, import, export)"/>
                    </StackPanel>
                </controls:HudPanel.HeaderContent>
                <Panel IsVisible="{Binding !IsFirstRun}">
                    <Grid IsVisible="{Binding !HasConfiguredPaths}"
                          ColumnDefinitions="*,12,*">
                        <controls:PathField Label="GAME"
                                            PathText="{Binding GamePath}"
                                            Watermark="Path to swkotor.exe"
                                            BrowseCommand="{Binding BrowseGameCommand}"
                                            IsBrowseEnabled="{Binding CanEditPaths}"/>
                        <controls:PathField Grid.Column="2"
                                            Label="PATCHES"
                                            PathText="{Binding PatchesPath}"
                                            Watermark="Directory containing .kpatch files"
                                            BrowseCommand="{Binding BrowsePatchesCommand}"
                                            IsBrowseEnabled="{Binding CanEditPaths}"/>
                    </Grid>
                    <StackPanel IsVisible="{Binding HasConfiguredPaths}"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="GAME"
                                       Classes="caption"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GamePathDisplay}"
                                       Classes="mono"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220"
                                       ToolTip.Tip="{Binding GamePath}"/>
                        </StackPanel>
                        <TextBlock Text="|"
                                   Foreground="{DynamicResource CaptionBrush}"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="PATCHES"
                                       Classes="caption"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PatchesPathDisplay}"
                                       Classes="mono"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220"
                                       ToolTip.Tip="{Binding PatchesPath}"/>
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </controls:HudPanel>

            <!-- 3. Body: INITIALIZE or workspace -->
            <Grid Grid.Row="2" Margin="16,12,16,0">
                <controls:HudPanel Header="INITIALIZE"
                                   IsVisible="{Binding IsFirstRun}">
                    <StackPanel Spacing="14"
                                VerticalAlignment="Center"
                                MaxWidth="560"
                                HorizontalAlignment="Center"
                                Margin="0,24">
                        <TextBlock Text="SELECT GAME EXECUTABLE"
                                   Classes="display"
                                   FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Point this console at swkotor.exe, swkotor2.exe, or the native KOTOR2 binary. Compatible patches will appear once a game is detected."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.85"/>
                        <Button Content="BROWSE GAME"
                                Command="{Binding BrowseGameCommand}"
                                Classes="primary"
                                HorizontalAlignment="Center"
                                MinWidth="180"
                                Height="36"/>
                    </StackPanel>
                </controls:HudPanel>

                <Grid x:Name="WorkspaceGrid"
                      ColumnDefinitions="2*,3*"
                      ColumnSpacing="12"
                      IsVisible="{Binding !IsFirstRun}">
                    <controls:HudPanel x:Name="PatchesPanel"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="{Binding PatchesColumnSpan}"
                                       Header="PATCHES"
                                       DragDrop.AllowDrop="True">
                        <controls:HudPanel.HeaderContent>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="ADD"
                                        Command="{Binding AddPatchCommand}"
                                        MinWidth="56"
                                        MinHeight="28"
                                        Padding="8,4"
                                        ToolTip.Tip="Copy a .kpatch into the patches folder"/>
                                <Button Classes="icon"
                                        Content="↑"
                                        Command="{Binding MoveUpCommand}"
                                        CommandParameter="{Binding SelectedPatch}"
                                        ToolTip.Tip="Change install order (list sort does not change staging order)"/>
                                <Button Classes="icon"
                                        Content="↓"
                                        Command="{Binding MoveDownCommand}"
                                        CommandParameter="{Binding SelectedPatch}"
                                        ToolTip.Tip="Change install order (list sort does not change staging order)"/>
                            </StackPanel>
                        </controls:HudPanel.HeaderContent>
                        <DockPanel>
                            <TextBox x:Name="SearchBox"
                                     DockPanel.Dock="Top"
                                     Text="{Binding SearchText}"
                                     Watermark="Search name, author, id"
                                     Margin="0,0,0,8"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Select a patch for details"
                                       Classes="caption"
                                       Margin="0,0,0,8"
                                       IsVisible="{Binding IsWorkspaceNarrow}"/>
                            <Grid DockPanel.Dock="Top"
                                  ColumnDefinitions="*,Auto,Auto"
                                  Margin="0,0,0,8">
                                <CheckBox IsThreeState="True"
                                          IsChecked="{Binding SelectAllPatches}"
                                          IsEnabled="{Binding HasVisiblePatches}">
                                    <TextBlock Text="SELECT ALL"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </CheckBox>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LibrarySortOptions}"
                                          SelectedItem="{Binding SelectedLibrarySortOption}"
                                          Width="120"
                                          Margin="0,0,8,0"
                                          MinHeight="28"
                                          ToolTip.Tip="Sort library">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LibrarySortOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding ShowIncompatible}"
                                          Content="SHOW INCOMPATIBLE"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding EmptyLibraryMessage}"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       IsVisible="{Binding HasEmptyLibrary}"/>
                            <ListBox ItemsSource="{Binding VisiblePatches}"
                                     SelectedItem="{Binding SelectedPatch}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.AllowAutoHide="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PatchItemViewModel">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                              Classes.muted="{Binding IsMuted}"
                                              ToolTip.Tip="{Binding CompatibilityStatus}">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsChecked}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding InstallOrderText}"
                                                       Classes="mono"
                                                       Width="28"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.85"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DisplayText}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="3"
                                                    Classes="badge"
                                                    Classes.badge-on="{Binding IsStateOn}"
                                                    Classes.badge-pending="{Binding IsStatePending}"
                                                    Classes.badge-warn="{Binding IsStateWarn}"
                                                    Classes.badge-error="{Binding IsStateError}"
                                                    IsVisible="{Binding HasStateLabel}">
                                                <TextBlock Text="{Binding StateLabel}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </controls:HudPanel>

                    <controls:HudPanel x:Name="DetailsPanel"
                                       Grid.Column="1"
                                       Header="PATCH DETAILS"
                                       IsVisible="{Binding !IsWorkspaceNarrow}">
                        <controls:PatchDetailsView/>
                    </controls:HudPanel>
                </Grid>
            </Grid>

            <!-- 4. CONSOLE -->
            <controls:HudPanel Grid.Row="3"
                               Header="CONSOLE"
                               Margin="16,12,16,16"
                               IsVisible="{Binding !IsFirstRun}">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Top"
                                 IsVisible="{Binding IsOperationInProgress}"
                                 IsIndeterminate="{Binding IsOperationInProgress}"
                                 Height="6"
                                 Margin="0,0,0,10"/>
                    <Border DockPanel.Dock="Top"
                            Classes="section-inset"
                            Margin="0,0,0,10"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsVisible="{Binding ShowCompactHealth}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding HealthSummary}"
                                       Classes="mono"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1"
                                    Content="REPAIR"
                                    Command="{Binding RepairStagingCommand}"
                                    MinWidth="88"
                                    MinHeight="28"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    ToolTip.Tip="Re-apply current selection to repair staging"/>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Top"
                            Classes="section-inset"
                            Margin="0,0,0,10"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            IsVisible="{Binding ShowExpandedHealth}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="STATUS" Classes="caption"/>
                                <TextBlock Text="{Binding HealthSummary}"
                                           Classes="mono"
                                           FontSize="12"
                                           Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Text="{Binding HealthDetail}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Opacity="0.85"
                                           IsVisible="{Binding HasHealthDetail}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="REPAIR"
                                    Command="{Binding RepairStagingCommand}"
                                    MinWidth="88"
                                    MinHeight="28"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Re-apply current selection to repair staging"/>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="0,10,0,0"
                                IsVisible="{Binding ShowLaunchSettings}">
                        <CheckBox Content="Custom launch command"
                                  IsChecked="{Binding UseCustomLaunch}"
                                  IsEnabled="{Binding CanEditPaths}"
                                  ToolTip.Tip="Off: launch through Steam. On: run your own command (Lutris, Heroic, Wine...)."/>
                        <TextBox Text="{Binding CustomLaunchCommand}"
                                 Watermark="e.g. wine &quot;{exe}&quot;   ({exe} = game path)"
                                 IsEnabled="{Binding UseCustomLaunch}"
                                 MinWidth="280"
                                 HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Classes="mono"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding StatusMessage}"/>
                            <TextBlock Text="•"
                                       Foreground="{DynamicResource CaptionBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasPendingChanges}"/>
                            <TextBlock Text="{Binding PendingChangesMessage}"
                                       Classes="mono"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding PendingChangesMessage}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10">
                            <Button Content="UNINSTALL ALL"
                                    Command="{Binding UninstallAllCommand}"
                                    Classes="destructive"
                                    MinWidth="140"
                                    Height="36"/>
                            <Button Content="APPLY"
                                    Command="{Binding ApplyPatchesCommand}"
                                    Classes.pending="{Binding HasPendingChanges}"
                                    MinWidth="120"
                                    Height="36"/>
                            <Button Content="LAUNCH"
                                    Command="{Binding LaunchGameCommand}"
                                    Classes="primary"
                                    MinWidth="120"
                                    Height="36"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </controls:HudPanel>
        </Grid>
    </Grid>
</Window>
