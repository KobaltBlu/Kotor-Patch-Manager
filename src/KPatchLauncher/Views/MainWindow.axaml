<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KPatchLauncher.ViewModels"
        xmlns:controls="using:KPatchLauncher.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
        x:Class="KPatchLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="KotOR Patch Manager"
        Width="1100" Height="740"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="42"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid>
        <!-- Softened grid + scanline overlays -->
        <Border IsHitTestVisible="False" Opacity="0.10">
            <Border.Background>
                <VisualBrush TileMode="Tile"
                             SourceRect="0,0,28,28"
                             DestinationRect="0,0,28,28">
                    <VisualBrush.Visual>
                        <Canvas Width="28" Height="28">
                            <Line StartPoint="0,28" EndPoint="28,28" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1"/>
                            <Line StartPoint="28,0" EndPoint="28,28" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1"/>
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False" Opacity="0.04">
            <Border.Background>
                <VisualBrush TileMode="Tile"
                             SourceRect="0,0,4,4"
                             DestinationRect="0,0,4,4">
                    <VisualBrush.Visual>
                        <Canvas Width="4" Height="4">
                            <Rectangle Width="4" Height="1" Fill="{DynamicResource PrimaryBrush}"/>
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="42,Auto,*,Auto" Margin="0">

            <!-- 1. Title bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  PointerPressed="OnTitleBarPointerPressed"
                  DoubleTapped="OnTitleBarDoubleTapped"
                  Background="Transparent">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="KOTOR PATCH MANAGER"
                               Classes="display"
                               FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="6"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Content="K1"
                            Classes="icon"
                            Width="36"
                            Command="{Binding SelectKotor1Command}"
                            Classes.pending="{Binding IsKotor1Target}"
                            IsVisible="{Binding HasKotor1Memory}"
                            ToolTip.Tip="Switch to remembered KotOR 1"/>
                    <Button Content="K2"
                            Classes="icon"
                            Width="36"
                            Command="{Binding SelectKotor2Command}"
                            Classes.pending="{Binding IsKotor2Target}"
                            IsVisible="{Binding HasKotor2Memory}"
                            ToolTip.Tip="Switch to remembered KotOR 2"/>
                </StackPanel>
                <Border Grid.Column="2"
                        Classes="version-badge"
                        IsVisible="{Binding !IsFirstRun}">
                    <TextBlock Text="{Binding KotorVersion}"/>
                </Border>
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Classes="chrome"
                            Content="ABOUT"
                            Width="56"
                            Command="{Binding OpenAboutCommand}"
                            ToolTip.Tip="About (F1)"/>
                    <Button Classes="chrome"
                            Content="—"
                            Click="OnMinimize"
                            ToolTip.Tip="Minimize"/>
                    <Button Classes="chrome"
                            Content="[]"
                            Click="OnMaximize"
                            ToolTip.Tip="Maximize"/>
                    <Button Classes="chrome close"
                            Content="X"
                            Click="OnClose"
                            ToolTip.Tip="Close"/>
                </StackPanel>
            </Grid>

            <!-- 2. TARGET -->
            <controls:HudPanel Grid.Row="1"
                               Header="TARGET"
                               Subtitle="{Binding KotorVersion, StringFormat=Detected: {0}}"
                               Margin="16,8,16,0">
                <controls:HudPanel.HeaderContent>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox ItemsSource="{Binding AvailableLoadouts}"
                                  SelectedItem="{Binding ActiveLoadout}"
                                  Width="148"
                                  MinHeight="28"
                                  PlaceholderText="Loadout"
                                  ToolTip.Tip="Select a named loadout to update the checklist. APPLY stages the game.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding ActiveLoadoutDisplayName}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Opacity="0.85"
                                   MinWidth="24"
                                   ToolTip.Tip="{Binding LoadoutDirtyHint}"/>
                        <TextBox Text="{Binding NewLoadoutName}"
                                 Width="100"
                                 Watermark="Name"
                                 MinHeight="28"
                                 ToolTip.Tip="Name for SAVE. Change name while a loadout is selected to rename it."/>
                        <Button Content="SAVE"
                                Command="{Binding SaveLoadoutCommand}"
                                MinWidth="56"
                                MinHeight="28"
                                Padding="8,4"
                                ToolTip.Tip="Save checklist into the selected loadout, or create/overwrite by name. APPLY still stages the game."/>
                        <Button Content="DUP"
                                Command="{Binding DuplicateLoadoutCommand}"
                                MinWidth="48"
                                MinHeight="28"
                                Padding="6,4"
                                ToolTip.Tip="Duplicate the selected loadout"/>
                        <Button Content="DEL"
                                Command="{Binding DeleteLoadoutCommand}"
                                Classes="pending"
                                MinWidth="48"
                                MinHeight="28"
                                Padding="6,4"
                                ToolTip.Tip="Delete the selected loadout"/>
                        <Button Content="CLR"
                                Command="{Binding ClearLoadoutCommand}"
                                MinWidth="48"
                                MinHeight="28"
                                Padding="6,4"
                                ToolTip.Tip="Clear loadout selection without changing checklist"/>
                        <Button Content="REFRESH"
                                Command="{Binding RefreshCommand}"
                                MinWidth="80"
                                MinHeight="28"
                                Padding="10,4"/>
                    </StackPanel>
                </controls:HudPanel.HeaderContent>
                <Grid ColumnDefinitions="*,12,*">
                    <controls:PathField Label="GAME"
                                        PathText="{Binding GamePath}"
                                        Watermark="Path to swkotor.exe"
                                        BrowseCommand="{Binding BrowseGameCommand}"
                                        IsBrowseEnabled="{Binding CanEditPaths}"/>
                    <controls:PathField Grid.Column="2"
                                        Label="PATCHES"
                                        PathText="{Binding PatchesPath}"
                                        Watermark="Directory containing .kpatch files"
                                        BrowseCommand="{Binding BrowsePatchesCommand}"
                                        IsBrowseEnabled="{Binding CanEditPaths}"/>
                </Grid>
            </controls:HudPanel>

            <!-- 3. Body: INITIALIZE or workspace -->
            <Grid Grid.Row="2" Margin="16,12,16,0">
                <controls:HudPanel Header="INITIALIZE"
                                   IsVisible="{Binding IsFirstRun}">
                    <StackPanel Spacing="14"
                                VerticalAlignment="Center"
                                MaxWidth="560"
                                HorizontalAlignment="Center"
                                Margin="0,24">
                        <TextBlock Text="SELECT GAME EXECUTABLE"
                                   Classes="display"
                                   FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Point this console at swkotor.exe, swkotor2.exe, or the native KOTOR2 binary. Compatible patches will appear once a game is detected."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.85"/>
                        <Button Content="BROWSE GAME"
                                Command="{Binding BrowseGameCommand}"
                                Classes="primary"
                                HorizontalAlignment="Center"
                                MinWidth="180"
                                Height="36"/>
                    </StackPanel>
                </controls:HudPanel>

                <Grid ColumnDefinitions="2*,3*"
                      ColumnSpacing="12"
                      IsVisible="{Binding !IsFirstRun}">
                    <controls:HudPanel Header="PATCHES">
                        <controls:HudPanel.HeaderContent>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="icon"
                                        Content="↑"
                                        Command="{Binding MoveUpCommand}"
                                        CommandParameter="{Binding SelectedPatch}"
                                        ToolTip.Tip="Move selected patch up"/>
                                <Button Classes="icon"
                                        Content="↓"
                                        Command="{Binding MoveDownCommand}"
                                        CommandParameter="{Binding SelectedPatch}"
                                        ToolTip.Tip="Move selected patch down"/>
                            </StackPanel>
                        </controls:HudPanel.HeaderContent>
                        <DockPanel>
                            <TextBox x:Name="SearchBox"
                                     DockPanel.Dock="Top"
                                     Text="{Binding SearchText}"
                                     Watermark="Search name, author, id"
                                     Margin="0,0,0,8"/>
                            <Grid DockPanel.Dock="Top"
                                  ColumnDefinitions="*,Auto,Auto"
                                  Margin="0,0,0,8">
                                <CheckBox IsThreeState="True"
                                          IsChecked="{Binding SelectAllPatches}"
                                          IsEnabled="{Binding HasVisiblePatches}">
                                    <TextBlock Text="Select All"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </CheckBox>
                                <ComboBox Grid.Column="1"
                                          SelectedItem="{Binding LibrarySortMode}"
                                          Width="110"
                                          Margin="0,0,8,0"
                                          MinHeight="28"
                                          ToolTip.Tip="Sort library">
                                    <ComboBox.Items>
                                        <x:String>name</x:String>
                                        <x:String>author</x:String>
                                        <x:String>installed</x:String>
                                        <x:String>pending</x:String>
                                    </ComboBox.Items>
                                </ComboBox>
                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding ShowIncompatible}"
                                          Content="Show incompatible"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding EmptyLibraryMessage}"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       IsVisible="{Binding HasEmptyLibrary}"/>
                            <ListBox ItemsSource="{Binding VisiblePatches}"
                                     SelectedItem="{Binding SelectedPatch}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.AllowAutoHide="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PatchItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              Classes.muted="{Binding IsMuted}"
                                              ToolTip.Tip="{Binding CompatibilityStatus}">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsChecked}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayText}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2"
                                                    Classes="badge"
                                                    Classes.badge-on="{Binding IsStateOn}"
                                                    Classes.badge-pending="{Binding IsStatePending}"
                                                    Classes.badge-warn="{Binding IsStateWarn}"
                                                    Classes.badge-error="{Binding IsStateError}"
                                                    IsVisible="{Binding HasStateLabel}">
                                                <TextBlock Text="{Binding StateLabel}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </controls:HudPanel>

                    <controls:HudPanel Grid.Column="1" Header="PATCH DETAILS">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          AllowAutoHide="False"
                                          IsVisible="{Binding SelectedPatch, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel>
                                    <!-- Identity -->
                                    <StackPanel Classes="hud-section">
                                        <TextBlock Text="IDENTITY" Classes="section-title"/>
                                        <Border Classes="section-rule"/>
                                        <Border Classes="section-inset">
                                            <StackPanel Spacing="10">
                                                <StackPanel>
                                                    <TextBlock Text="NAME" Classes="caption"/>
                                                    <TextBlock Text="{Binding SelectedPatch.Name}"
                                                               Classes="display"
                                                               FontSize="18"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedPatch.TagsText}"
                                                           Classes="mono"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource CaptionBrush}"
                                                           IsVisible="{Binding SelectedPatch.HasTags}"/>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                    <StackPanel>
                                                        <TextBlock Text="VERSION" Classes="caption"/>
                                                        <TextBlock Text="{Binding SelectedPatch.Version}" Classes="mono"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="AUTHOR" Classes="caption"/>
                                                        <TextBlock Text="{Binding SelectedPatch.Author}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Text="DESCRIPTION" Classes="caption"/>
                                                    <TextBlock Text="{Binding SelectedPatch.Description}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding SelectedPatch.HasLicense}">
                                                    <TextBlock Text="LICENSE" Classes="caption"/>
                                                    <TextBlock Text="{Binding SelectedPatch.License}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding SelectedPatch.HasUrl}">
                                                    <TextBlock Text="URL" Classes="caption"/>
                                                    <Button Classes="link"
                                                            Content="{Binding SelectedPatch.Url}"
                                                            Command="{Binding OpenUrlCommand}"
                                                            CommandParameter="{Binding SelectedPatch.Url}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedPatch.AdditionalFilesNote}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           IsVisible="{Binding SelectedPatch.HasAdditionalFiles}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Options -->
                                    <StackPanel Classes="hud-section"
                                                IsVisible="{Binding SelectedPatch.HasOptions}">
                                        <TextBlock Text="OPTIONS" Classes="section-title"/>
                                        <Border Classes="section-rule"/>
                                        <Border Classes="section-inset">
                                            <ItemsControl ItemsSource="{Binding SelectedPatch.Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PatchOptionItemViewModel">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" Classes="caption"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           TextWrapping="Wrap"
                                                                           FontSize="12"
                                                                           Opacity="0.8"/>
                                                            </StackPanel>
                                                            <NumericUpDown Grid.Column="1"
                                                                           Value="{Binding Value}"
                                                                           Minimum="{Binding Min}"
                                                                           Maximum="{Binding Max}"
                                                                           Width="100"
                                                                           FormatString="0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>

                                    <!-- Dependencies -->
                                    <StackPanel Classes="hud-section"
                                                IsVisible="{Binding SelectedPatch.HasDependencies}">
                                        <TextBlock Text="DEPENDENCIES" Classes="section-title"/>
                                        <Border Classes="section-rule"/>
                                        <Border Classes="section-inset">
                                            <StackPanel Spacing="10">
                                                <StackPanel IsVisible="{Binding SelectedPatch.HasRequires}">
                                                    <TextBlock Text="REQUIRES" Classes="caption"/>
                                                    <ItemsControl ItemsSource="{Binding SelectedPatch.Requires}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Classes="link"
                                                                        Content="{Binding}"
                                                                        Command="{Binding $parent[Window].DataContext.SelectPatchCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding SelectedPatch.HasConflicts}">
                                                    <TextBlock Text="CONFLICTS" Classes="caption"/>
                                                    <ItemsControl ItemsSource="{Binding SelectedPatch.Conflicts}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Classes="link"
                                                                        Content="{Binding}"
                                                                        Command="{Binding $parent[Window].DataContext.SelectPatchCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Compatibility -->
                                    <StackPanel Classes="hud-section" Margin="0">
                                        <TextBlock Text="COMPATIBILITY" Classes="section-title"/>
                                        <Border Classes="section-rule"/>
                                        <Border Classes="section-inset">
                                            <StackPanel Spacing="10">
                                                <StackPanel IsVisible="{Binding SelectedPatch.HasSupportedVersions}">
                                                    <TextBlock Text="SUPPORTED VERSIONS" Classes="caption"/>
                                                    <TextBlock Text="{Binding SelectedPatch.SupportedVersionsText}"
                                                               Classes="mono"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="STATUS" Classes="caption"/>
                                                    <TextBlock Text="{Binding SelectedPatch.CompatibilityStatus}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border Background="{DynamicResource ErrorBackgroundBrush}"
                                                        BorderBrush="{DynamicResource ErrorBrush}"
                                                        BorderThickness="1"
                                                        Padding="8"
                                                        IsVisible="{Binding SelectedPatch.IsOrphaned}">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="ORPHANED PATCH"
                                                                   Classes="display"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ErrorBrush}"/>
                                                        <TextBlock Text="Installed in the game but missing from the patches directory. Unchecking it uninstalls it."
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource PanelFillBrush}"
                                                        BorderBrush="{DynamicResource WarningBrush}"
                                                        BorderThickness="1"
                                                        Padding="8"
                                                        IsVisible="{Binding HasDependencyWarning}">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="DEPENDENCY WARNING"
                                                                   Classes="display"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource WarningBrush}"/>
                                                        <TextBlock Text="{Binding DependencyWarning}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock Text="Select a patch to view details"
                                       Classes="caption"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding SelectedPatch, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </Grid>
                    </controls:HudPanel>
                </Grid>
            </Grid>

            <!-- 4. COMMANDS -->
            <controls:HudPanel Grid.Row="3"
                               Header="COMMANDS"
                               Margin="16,12,16,16"
                               IsVisible="{Binding !IsFirstRun}">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Top"
                                 IsVisible="{Binding IsOperationInProgress}"
                                 IsIndeterminate="{Binding IsOperationInProgress}"
                                 Height="6"
                                 Margin="0,0,0,10"/>
                    <Border DockPanel.Dock="Top"
                            Classes="section-inset"
                            Margin="0,0,0,10"
                            BorderBrush="{DynamicResource PrimaryBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="STATUS" Classes="caption"/>
                                <TextBlock Text="{Binding HealthSummary}"
                                           Classes="mono"
                                           FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           IsVisible="{Binding HealthOk}"/>
                                <TextBlock Text="{Binding HealthSummary}"
                                           Classes="mono"
                                           FontSize="12"
                                           Foreground="{DynamicResource WarningBrush}"
                                           IsVisible="{Binding !HealthOk}"/>
                                <TextBlock Text="{Binding HealthDetail}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Opacity="0.85"
                                           IsVisible="{Binding HasHealthDetail}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="REPAIR"
                                    Command="{Binding RepairStagingCommand}"
                                    MinWidth="88"
                                    MinHeight="28"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Re-apply current selection to repair staging"/>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="0,10,0,0"
                                IsVisible="{Binding ShowLaunchSettings}">
                        <CheckBox Content="Custom launch command"
                                  IsChecked="{Binding UseCustomLaunch}"
                                  IsEnabled="{Binding CanEditPaths}"
                                  ToolTip.Tip="Off: launch through Steam. On: run your own command (Lutris, Heroic, Wine...)."/>
                        <TextBox Text="{Binding CustomLaunchCommand}"
                                 Watermark="e.g. wine &quot;{exe}&quot;   ({exe} = game path)"
                                 IsEnabled="{Binding UseCustomLaunch}"
                                 MinWidth="280"
                                 HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Classes="mono"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="•"
                                       Foreground="{DynamicResource CaptionBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasPendingChanges}"/>
                            <TextBlock Text="{Binding PendingChangesMessage}"
                                       Classes="mono"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10">
                            <Button Content="UNINSTALL ALL"
                                    Command="{Binding UninstallAllCommand}"
                                    MinWidth="140"
                                    Height="36"/>
                            <Button Content="APPLY"
                                    Command="{Binding ApplyPatchesCommand}"
                                    Classes.pending="{Binding HasPendingChanges}"
                                    MinWidth="120"
                                    Height="36"/>
                            <Button Content="LAUNCH"
                                    Command="{Binding LaunchGameCommand}"
                                    Classes="primary"
                                    MinWidth="120"
                                    Height="36"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </controls:HudPanel>
        </Grid>
    </Grid>
</Window>
