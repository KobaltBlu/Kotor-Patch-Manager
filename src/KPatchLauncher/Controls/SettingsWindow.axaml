<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KPatchLauncher.Controls"
        xmlns:vm="using:KPatchLauncher.ViewModels"
        x:Class="KPatchLauncher.Controls.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="Settings"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">
    <controls:HudPanel Header="SETTINGS" Margin="0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="CLOSE"
                        Classes="primary"
                        MinWidth="110"
                        Click="OnClose"/>
            </StackPanel>

            <StackPanel Spacing="0">
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            Margin="0,0,0,14">
                    <Button Content="KOTOR 1"
                            MinWidth="120"
                            Command="{Binding SelectSettingsKotor1Command}"
                            Classes.pending="{Binding IsSettingsScopeKotor1}"/>
                    <Button Content="KOTOR 2"
                            MinWidth="120"
                            Command="{Binding SelectSettingsKotor2Command}"
                            Classes.pending="{Binding IsSettingsScopeKotor2}"/>
                </StackPanel>

                <StackPanel Classes="hud-section">
                    <TextBlock Text="PATHS" Classes="section-title"/>
                    <Border Classes="section-rule"/>
                    <Border Classes="section-inset">
                        <StackPanel Spacing="12">
                            <controls:PathField Label="GAME"
                                                PathText="{Binding SettingsGamePath}"
                                                Watermark="{Binding SettingsGamePathWatermark}"
                                                BrowseCommand="{Binding BrowseSettingsGameCommand}"
                                                IsBrowseEnabled="{Binding CanEditPaths}"/>
                            <controls:PathField Label="PATCHES"
                                                PathText="{Binding SettingsPatchesPath}"
                                                Watermark="Directory containing .kpatch files"
                                                BrowseCommand="{Binding BrowseSettingsPatchesCommand}"
                                                IsBrowseEnabled="{Binding CanEditPaths}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="hud-section">
                    <TextBlock Text="APPEARANCE" Classes="section-title"/>
                    <Border Classes="section-rule"/>
                    <Border Classes="section-inset">
                        <StackPanel Spacing="10">
                            <TextBlock Text="THEME" Classes="caption"/>
                            <ComboBox ItemsSource="{Binding UiThemeOptions}"
                                      SelectedItem="{Binding SelectedSettingsUiThemeOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UiThemeOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Each game remembers its own theme. Auto uses this game's default palette."
                                       Classes="caption"
                                       Opacity="0.85"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="IMPORT"
                                        Command="{Binding ImportUiThemeCommand}"
                                        MinWidth="90"/>
                                <Button Content="EXPORT"
                                        Command="{Binding ExportUiThemeCommand}"
                                        MinWidth="90"/>
                                <Button Content="OPEN FOLDER"
                                        Command="{Binding OpenUiThemesFolderCommand}"
                                        MinWidth="110"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </controls:HudPanel>
</Window>
