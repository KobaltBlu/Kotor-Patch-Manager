<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KPatchLauncher.Controls">

    <Style Selector="controls|HudPanel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Background="{DynamicResource PanelFillBrush}"
                            BorderBrush="{DynamicResource BorderLineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource HudCornerRadius}"/>

                    <Grid IsHitTestVisible="False">
                        <Path Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Data="M 0,16 L 0,0 L 16,0"/>
                        <Path Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 16,0 L 16,16"/>
                        <Path Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Data="M 0,0 L 0,16 L 16,16"/>
                        <Path Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Data="M 16,0 L 16,16 L 0,16"/>
                    </Grid>

                    <DockPanel Margin="14,12">
                        <StackPanel DockPanel.Dock="Top"
                                    Spacing="6"
                                    Margin="0,0,0,10"
                                    IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Right"
                                                  Content="{TemplateBinding HeaderContent}"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"/>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Classes="display"
                                               FontSize="15"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{TemplateBinding Subtitle}"
                                               Classes="mono"
                                               FontSize="11"
                                               Foreground="{DynamicResource CaptionBrush}"
                                               IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1"
                                    Background="{DynamicResource BorderLineBrush}"
                                    Opacity="0.55"/>
                        </StackPanel>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </DockPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource HudBodyFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{StaticResource HudDisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="2"/>
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource CaptionBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HudBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LetterSpacing" Value="0.8"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackgroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource HudCornerRadius}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource PanelFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontFamily" Value="{StaticResource HudBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="{DynamicResource HudCornerRadius}"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarmAccentHighlightBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WarmAccentHighlightBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarmAccentHighlightBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <Style Selector="Button.pending">
        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.pending:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
    </Style>

    <Style Selector="Button.destructive">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.destructive:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Button.destructive:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource HudCornerRadius}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource PanelFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="Button.chrome">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,1"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SelectionBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HudBodyFont}"/>
    </Style>
    <Style Selector="CheckBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Grid.muted">
        <Setter Property="Opacity" Value="0.72"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="6,5,6,5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundDarkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ListBox /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="MinWidth" Value="{DynamicResource ScrollBarSize}"/>
        <Setter Property="Width" Value="{DynamicResource ScrollBarSize}"/>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="MinHeight" Value="{DynamicResource ScrollBarSize}"/>
        <Setter Property="Height" Value="{DynamicResource ScrollBarSize}"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ProgressBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource HudBodyFont}"/>
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="4,0,2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LetterSpacing" Value="0.8"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Border.badge-on">
        <Setter Property="BorderBrush" Value="{DynamicResource ActiveBrush}"/>
    </Style>
    <Style Selector="Border.badge-on TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ActiveBrush}"/>
    </Style>
    <Style Selector="Border.badge-pending">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="Border.badge-pending TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Border.badge-warn">
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Border.badge-warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Border.badge-error">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.badge-error TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <Style Selector="Border.version-badge">
        <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style Selector="Border.version-badge TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource CaptionBrush}"/>
    </Style>

    <Style Selector="StackPanel.hud-section">
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style Selector="StackPanel.hud-section > TextBlock.section-title">
        <Setter Property="FontFamily" Value="{StaticResource HudDisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LetterSpacing" Value="2"/>
        <Setter Property="Foreground" Value="{DynamicResource CaptionBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style Selector="Border.section-rule">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource GridLineBrush}"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="Border.section-inset">
        <Setter Property="Background" Value="{DynamicResource PanelInsetBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource HudCornerRadius}"/>
    </Style>
</Styles>
