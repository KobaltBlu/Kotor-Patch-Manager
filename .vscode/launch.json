{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KPatchLauncher (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/KPatchLauncher.dll",
      "cwd": "${workspaceFolder}/bin/Debug",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "KPatchLauncher (Debug + Attach Pause)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/KPatchLauncher.dll",
      "cwd": "${workspaceFolder}/bin/Debug",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "KPATCH_DEBUG_ATTACH": "1"
      }
    },
    {
      "name": "Attach: KotorPatcher (game process)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
